# Graphenium Datalog Standard Library
# Pre-loaded predicates for codebase reasoning. Do not redefine in user queries.

# ── Transitive Closures (Pathfinding & Reachability) ─────────────────────────

# Transitive calls: X directly or indirectly calls Y
calls_transitive(X, Y) :- calls(X, Y, _).
calls_transitive(X, Y) :- calls(X, Z, _), calls_transitive(Z, Y).

# Transitive imports: X directly or indirectly imports Y
imports_transitive(X, Y) :- imports(X, Y, _).
imports_transitive(X, Y) :- imports(X, Z, _), imports_transitive(Z, Y).

# Generic dependency: X directly depends on Y (calls, imports, inherits, implements, contains)
depends_on(X, Y) :- calls(X, Y, _).
depends_on(X, Y) :- imports(X, Y, _).
depends_on(X, Y) :- inherits(X, Y, _).
depends_on(X, Y) :- implements(X, Y, _).
depends_on(X, Y) :- contains(X, Y, _).

depends_transitive(X, Y) :- depends_on(X, Y).
depends_transitive(X, Y) :- depends_on(X, Z), depends_transitive(Z, Y).

# ── Topological Helpers ────────────────────────────────────────────────────────

# Same community: X and Y belong to the same Louvain cluster
same_community(X, Y) :-
    node(X, _, _, _, CommId),
    node(Y, _, _, _, CommId).

# Architectural Hub (God Node): degree > 15 (hub/1 seeded from degree in EDB)
is_hub(X) :- hub(X).

# Orphaned Node: zero call/import connections (knowledge gap)
is_orphan(X) :-
    node(X, _, _, _, _),
    not calls(X, _, _),
    not calls(_, X, _),
    not imports(X, _, _),
    not imports(_, X, _).

# ── Architectural Gating & Constraints ───────────────────────────────────────

# Equality helper (kept for backwards compatibility; prefer `X != Y`).
identical(X, X) :- node(X, _, _, _, _).

# Circular dependency: X and Y call each other transitively
circular_dependency(X, Y) :-
    calls_transitive(X, Y),
    calls_transitive(Y, X),
    not identical(X, Y).

# Bypass verification: X depends on Z transitively, bypassing intermediary Y
bypasses_layer(X, Y, Z) :-
    depends_transitive(X, Z),
    node(Y, _, _, _, _),
    not depends_transitive(X, Y).

# ── Structural Containment & Formal Verification Auditing ────────────────────

# Transitive containment: X transitively contains child/field/method Y
contains_transitive(X, Y) :- contains(X, Y, _).
contains_transitive(X, Y) :- contains(X, Z, _), contains_transitive(Z, Y).

# Container-member aliasing hazard at a call site:
# Caller invokes Target while depending on both Container and its internal Member.
aliased_container_call(Caller, Target, Container, Member) :-
    calls(Caller, Target, _),
    contains_transitive(Container, Member),
    depends_on(Caller, Container),
    depends_on(Caller, Member),
    not identical(Container, Member).

# Unreachable symbol from a designated entry point (e.g. "main"):
# Node exists in the graph but is not transitively reachable from Entry.
unreachable_from(Entry, Node) :-
    node(Entry, _, _, _, _),
    node(Node, _, _, _, _),
    not identical(Entry, Node),
    not depends_transitive(Entry, Node).

# Proof-gap taint propagation:
# Symbol X directly contains or transitively depends on an unverified_sorry gap.
# Propagate backwards from the gaps instead of materialising the entire
# depends_transitive closure first. The two formulations are equivalent, but
# reverse propagation is near-linear and keeps large Lean repositories
# (thousands of nodes) well inside the 30s solver budget.
has_proof_gap(X) :- edge(X, X, "unverified_sorry", _).
tainted_by_proof_gap(X) :- has_proof_gap(X).
tainted_by_proof_gap(X) :- depends_on(X, Y), tainted_by_proof_gap(Y).

# ── Lean 4 trust-boundary auditing (semantic `#print axioms` ingestion) ──────
# `Edge` normalizes node IDs, so kernel axiom names arrive as e.g.
# "classical_choice" / "quot_sound" rather than their Lean spellings.

uses_axiom(Decl, Axiom) :- edge(Decl, Axiom, "depends_on_axiom", _).

# Binder hypotheses / structure parameters: T is conditional on H when its
# signature takes `(h : H)` or `[Fact P]`. Both relations are recognized so
# extractors can choose either spelling.
depends_on_hypothesis(X, H) :- edge(X, H, "depends_on_hypothesis", _).
depends_on_hypothesis(X, H) :- edge(X, H, "parameter_type", _).

# Transitive hypothesis inheritance through the same dependency cone used by
# `gm trust` (calls, depends_on, inherits, implements, imports).
inherits_hypothesis(X, H) :- depends_on_hypothesis(X, H).
inherits_hypothesis(X, H) :- depends_on(X, Y), inherits_hypothesis(Y, H).
inherits_hypothesis(X, H) :- imports(X, Y, _), inherits_hypothesis(Y, H).
inherits_hypothesis(X, H) :- inherits(X, Y, _), inherits_hypothesis(Y, H).
inherits_hypothesis(X, H) :- implements(X, Y, _), inherits_hypothesis(Y, H).

# A theorem is conditional (kernel-clean but hypothesis-dependent) when it
# inherits at least one binder hypothesis and has no direct proof gap.
conditional_theorem(X) :-
    inherits_hypothesis(X, _),
    not tainted_by_proof_gap(X).

# `native_decide` relies on Lean.trustCompiler / Lean.ofReduceBool.
has_native_decide(X) :- edge(X, X, "unverified_native_decide", _).

# Any non-kernel axiom inherited by X (user-declared axioms, certificate
# axioms, or the deliberate proof gaps handled above).
has_untrusted_axiom(X) :-
    uses_axiom(X, Ax),
    Ax != "propext",
    Ax != "classical_choice",
    Ax != "quot_sound".

# A theorem is untrusted if it contains a sorry gap or inherits a non-kernel
# axiom. Native-decision shortcuts are reported separately (`has_native_decide`)
# so existing proof-gap gates stay source-compatible.
untrusted_theorem(X) :- tainted_by_proof_gap(X).
untrusted_theorem(X) :- has_untrusted_axiom(X).
